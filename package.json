{
  "name": "whispers",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:demo": "VITE_WHISPERS_REVIEWER_BACKEND=demo VITE_WHISPERS_PILOT_BACKEND=demo VITE_WHISPERS_DEMO_ONLY=true WHISPERS_PILOT_BACKEND=demo npm run build -- --mode demo",
    "build:dev": "vite build --mode development",
    "deploy:demo": "npm run build:demo && npx wrangler@latest preview --config wrangler.demo.jsonc --name owner-demo --worker-name whispers-neon-pilot --ignore-base-config",
    "deploy:staging": "npm run build -- --mode staging && npx wrangler@latest preview --config wrangler.preview.jsonc --name staging-neon --worker-name whispers-neon-pilot",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
