{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whispers-neon-pilot",
  "main": ".output/server/worker-entry.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
